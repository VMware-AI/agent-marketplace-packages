{
  "openapi": "3.0.3",
  "info": {
    "title": "marketplace-api",
    "version": "0.1.0",
    "description": "Read-only HTTP server that exposes a dist/ directory of agent tarballs as a JSON + tarball API. Auth is HTTP Basic Auth on every endpoint except /api/v1/health (which is anonymous by design so that Docker / k8s healthchecks do not need credentials)."
  },
  "servers": [
    {
      "url": "https://{host}:8443",
      "variables": {
        "host": {
          "default": "localhost",
          "description": "Hostname or IP of the marketplace-api instance."
        }
      }
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "Liveness probe — anonymous."
    },
    {
      "name": "index",
      "description": "Discovery — list agents and versions."
    },
    {
      "name": "agents",
      "description": "Per-agent detail."
    },
    {
      "name": "artifacts",
      "description": "Tarball bytes, sha256 sidecar, config schema."
    },
    {
      "name": "docs",
      "description": "This OpenAPI spec + Swagger UI."
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTP Basic Auth. Username is informational; only the password is validated against the value of the env var named by auth.password_env (default MARKETPLACE_API_PASSWORD)."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "not_found"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      },
      "IndexStripped": {
        "type": "object",
        "description": "Card-grid projection: drops per-version Body / Inputs / Requires / EntryPoint. Optional ?channel=X projects to the latest semver version per skill in that channel.",
        "properties": {
          "generated_at": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkillStripped"
            }
          }
        }
      },
      "AgentStripped": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "logo": {
            "type": "string",
            "description": "Empty, http(s) URL, or data:image/...;base64,... — see meta-yaml-schema.md"
          },
          "category": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VersionStripped"
            }
          },
          "runtime_type": {
            "type": "string",
            "enum": [
              "vm",
              "container",
              "k8s"
            ],
            "description": "Deployment target declared in meta.yaml — stable across all versions of the agent."
          }
        }
      },
      "VersionStripped": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "upstream",
              "ours"
            ]
          },
          "channel": {
            "type": "string",
            "enum": [
              "stable",
              "beta",
              "edge",
              "internal"
            ]
          },
          "released_at": {
            "type": "string"
          },
          "tarball": {
            "$ref": "#/components/schemas/Tarball"
          }
        }
      },
      "Tarball": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "sha256": {
            "type": "string",
            "description": "Format: sha256:<hex>",
            "example": "sha256:fc78..."
          }
        }
      },
      "Agent": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "logo": {
            "type": "string",
            "description": "Empty, http(s) URL, or data:image/...;base64,... — see meta-yaml-schema.md"
          },
          "category": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Version"
            }
          },
          "runtime_type": {
            "type": "string",
            "enum": [
              "vm",
              "container",
              "k8s"
            ],
            "description": "Deployment target declared in meta.yaml — stable across all versions of the agent."
          }
        }
      },
      "Version": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "released_at": {
            "type": "string"
          },
          "tarball": {
            "$ref": "#/components/schemas/Tarball"
          },
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          }
        }
      },
      "Manifest": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "released_at": {
            "type": "string"
          },
          "upstream": {
            "$ref": "#/components/schemas/Upstream"
          },
          "fork_of": {
            "$ref": "#/components/schemas/ForkOf"
          },
          "requires": {
            "$ref": "#/components/schemas/Requires"
          },
          "runtime_requirements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RuntimeRequirement"
            }
          },
          "payload": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PayloadEntry"
            }
          },
          "checksums": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "tarball": {
            "$ref": "#/components/schemas/TarballRef"
          },
          "upgrade": {
            "$ref": "#/components/schemas/Upgrade"
          },
          "scripts": {
            "$ref": "#/components/schemas/Scripts"
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceSpec"
            }
          },
          "configs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConfigSpec"
            }
          }
        }
      },
      "Upstream": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "ForkOf": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "Requires": {
        "type": "object",
        "description": "Environment / tool requirements for running the skill.",
        "properties": {
          "os": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "linux",
                "darwin",
                "windows"
              ]
            }
          },
          "arch": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "amd64",
                "arm64",
                "386",
                "arm"
              ]
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "basename, e.g. 'bash', 'jq'"
            }
          }
        }
      },
      "RuntimeRequirement": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "description": "Constraint expression understood by the agent's install.sh, e.g. '>=22.22.3 <23' or '>=3.12,<3.14'."
          },
          "install_hint": {
            "type": "string"
          },
          "verify_cmd": {
            "type": "string"
          }
        }
      },
      "PayloadEntry": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string"
          },
          "dst": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          }
        }
      },
      "TarballRef": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      },
      "Upgrade": {
        "type": "object",
        "properties": {
          "strategy": {
            "type": "string"
          },
          "compatible_from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "migrations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MigrationEntry"
            }
          }
        }
      },
      "MigrationEntry": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "script": {
            "type": "string"
          }
        }
      },
      "Scripts": {
        "type": "object",
        "properties": {
          "install": {
            "type": "string"
          },
          "uninstall": {
            "type": "string"
          }
        }
      },
      "ServiceSpec": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "restart": {
            "type": "string",
            "enum": [
              "no",
              "on-failure",
              "always"
            ]
          },
          "working_dir": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ConfigSpec": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "render_to": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "required_inputs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InputField"
            }
          },
          "optional_inputs": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/InputField"
            }
          },
          "supported_providers": {
            "$ref": "#/components/schemas/SupportedProviders"
          }
        }
      },
      "InputField": {
        "type": "object",
        "properties": {
          "input_key": {
            "type": "string"
          },
          "json_path": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required_when": {
            "type": "string"
          },
          "enum_values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validate": {
            "type": "string"
          },
          "dynamic_resolve": {
            "type": "string"
          }
        }
      },
      "SupportedProviders": {
        "type": "object",
        "properties": {
          "builtin": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BuiltinProvider"
            }
          },
          "custom": {
            "$ref": "#/components/schemas/CustomProviderHint"
          }
        }
      },
      "BuiltinProvider": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "api_key_env": {
            "type": "string"
          },
          "auth": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "CustomProviderHint": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "npm_default": {
            "type": "string"
          }
        }
      },
      "Skill": {
        "type": "object",
        "description": "One skill entry. Skill-level fields are stable across all versions. Schema v2.0.",
        "properties": {
          "name": {
            "type": "string",
            "description": "kebab-case, ^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "display_name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "1-1024 chars, no < or >"
          },
          "author": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "license": {
            "type": "string"
          },
          "homepage": {
            "type": "string",
            "description": "http(s) URL only"
          },
          "created_at": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "category": {
            "type": "string",
            "description": "Schema v2.0: skill's functional domain (ops, dev, data, search, media, content, integration, productivity, other)."
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkillVersion"
            }
          }
        },
        "required": ["name", "description", "category"]
      },
      "SkillStripped": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "license": {
            "type": "string"
          },
          "homepage": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "description": "Schema v2.0: skill's functional domain."
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkillVersionStripped"
            }
          }
        },
        "required": ["category"]
      },
      "SkillVersion": {
        "type": "object",
        "description": "One (source, channel, version) entry. Immutable once uploaded (409 on conflict). Schema v2.0.",
        "properties": {
          "version": {
            "type": "string",
            "description": "Strict semver MAJOR.MINOR.PATCH[-prerelease]"
          },
          "source": {
            "type": "string",
            "enum": [
              "community",
              "internal"
            ]
          },
          "channel": {
            "type": "string",
            "enum": [
              "stable",
              "beta",
              "edge",
              "internal"
            ]
          },
          "released_at": {
            "type": "string"
          },
          "requires": {
            "$ref": "#/components/schemas/Requires"
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Input"
            }
          },
          "entry_point": {
            "type": "string",
            "description": "Path inside the zip"
          },
          "agents": {
            "type": "array",
            "description": "Schema v2.0: runtimes that recognize this skill payload. ['all'] for system-wide installs.",
            "items": {
              "type": "string",
              "enum": ["opencode", "openclaw", "hermes", "all"]
            }
          },
          "install_method": {
            "type": "string",
            "description": "Schema v2.0: install pipeline used by agentpkg skills install.",
            "enum": ["zip-extract", "pip-wheel", "npm-pack", "tarball"],
            "default": "zip-extract"
          },
          "install_paths": {
            "type": "object",
            "description": "Schema v2.0: per-agent path override. Keys are agent IDs; values are $HOME/$NAME templates.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "install_config": {
            "type": "object",
            "description": "Schema v2.0: per-method configuration. Shape depends on install_method.",
            "additionalProperties": true
          },
          "zip": {
            "$ref": "#/components/schemas/Zip"
          },
          "body": {
            "type": "string",
            "description": "Full SKILL.md text (frontmatter + body) embedded for UI convenience"
          }
        },
        "required": ["agents", "install_method"]
      },
      "SkillVersionStripped": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "released_at": {
            "type": "string"
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "install_method": {
            "type": "string"
          },
          "install_paths": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "zip": {
            "$ref": "#/components/schemas/Zip"
          }
        }
      },
      "Index": {
        "type": "object",
        "description": "Full content of dist/skills-index.json. Each Skill's Versions include the embedded SKILL.md body so UI list views don't need to unzip.",
        "properties": {
          "generated_at": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Skill"
            }
          }
        }
      },
      "Input": {
        "type": "object",
        "description": "User-facing input field schema. Informational — runtime consumers decide whether to enforce.",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "integer",
              "boolean",
              "number",
              "enum"
            ]
          },
          "enum_values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Required when type=enum"
          },
          "default": {
            "type": "string"
          }
        }
      },
      "Zip": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "description": "<name>-<source>-<version>.zip"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "sha256": {
            "type": "string",
            "description": "sha256:<hex>"
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe",
        "description": "Anonymous — does not require auth. Returns 200 OK as long as the process is up and the dist/ index has loaded.",
        "security": [],
        "responses": {
          "200": {
            "description": "Server is alive.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "version"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/index": {
      "get": {
        "tags": [
          "index"
        ],
        "summary": "List all agents and versions (manifests stripped).",
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexStripped"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/api/v1/agents/{name}": {
      "get": {
        "tags": [
          "agents"
        ],
        "summary": "Get one agent (all versions, full manifests).",
        "parameters": [
          {
            "$ref": "#/components/parameters/AgentName"
          }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/agents/{name}/{source}/{version}/manifest": {
      "get": {
        "tags": [
          "agents"
        ],
        "summary": "Get the full technical manifest.json for one (name, source, version).",
        "parameters": [
          {
            "$ref": "#/components/parameters/AgentName"
          },
          {
            "$ref": "#/components/parameters/Source"
          },
          {
            "$ref": "#/components/parameters/Version"
          }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Manifest"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/agents/{name}/{source}/{version}/tarball": {
      "get": {
        "tags": [
          "artifacts"
        ],
        "summary": "Stream the tarball bytes (application/gzip).",
        "parameters": [
          {
            "$ref": "#/components/parameters/AgentName"
          },
          {
            "$ref": "#/components/parameters/Source"
          },
          {
            "$ref": "#/components/parameters/Version"
          }
        ],
        "responses": {
          "200": {
            "description": "Tarball bytes.",
            "content": {
              "application/gzip": {
